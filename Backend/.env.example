# LaundryFlow Backend — Environment Variables Template
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development

# MongoDB
MONGO_URL=

# Authentication
JWT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ─── Razorpay (Payment Gateway) ──────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── SMS / OTP Gateways ──────────────────────────────
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp

TWOFACTOR_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set to true to skip real OTP sending in development
OTP_DEV_MODE=true

# ─── Firebase Admin SDK ───────────────────────────────
# Uses firebase-service-account.json — do NOT commit that file.
# Place firebase-service-account.json in Backend/ locally only.

# ─── Cloudinary (Image Upload) ───────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
